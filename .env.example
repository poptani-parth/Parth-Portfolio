# Copy to .env locally or configure these as deployment environment variables. Do not commit .env.

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=local
PORT=8081

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- MongoDB Atlas ---
# Use a dedicated `portfolio_app` DB user scoped to readWrite on the `portfolio` database only
# (see SECURITY.md). Never commit a real connection string here.
MONGODB_URI=mongodb+srv://portfolio_app:replace-me@cluster.example.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_AUTO_INDEX_CREATION=true

# --- JWT ---
# Generate a fresh secret per environment - never reuse this file's value anywhere:
#   openssl rand -base64 48
JWT_SECRET= 404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# --- SMTP / Email ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mailer@example.com
# Use an app password, not your normal account password.
MAIL_PASSWORD=replace-me
ADMIN_RESET_EMAIL=you@example.com
CONTACT_MAIL_TO=you@example.com

# # Contact API rate limiting
CONTACT_RATE_LIMIT_MAX_REQUESTS=3
CONTACT_RATE_LIMIT_WINDOW_MINUTES=60

# --- Admin bootstrap ---
ADMIN_USERNAME=admin
# Generate once with BCrypt (e.g. Spring's BCryptPasswordEncoder) and store the hash, not the
# password. Must be a real 60-character bcrypt hash or the app throws IllegalStateException.
ADMIN_PASSWORD_HASH=$2a$12$replace-with-a-valid-60-character-bcrypt-hash
# Copy to .env locally or configure these as deployment environment variables. Do not commit .env.
ADMIN_BOOTSTRAP_ENABLED=false

# --- HTTPS enforcement ---
FORCE_HTTPS=false
UPLOAD_PUBLIC_URL=http://localhost:8180/uploads/

# -- Redis URL ---
REDIS_URL=redis://localhost:6189\

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict

